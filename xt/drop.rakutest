
use v6.d;

use NativeCall;

use GnomeTools::Gtk::DND;

use Gnome::Glib::N-MainLoop:api<2>;

use Gnome::Gtk4::DropTarget:api<2>;
use Gnome::Gtk4::Window:api<2>;
use Gnome::Gtk4::Picture:api<2>;
use Gnome::Gtk4::Grid:api<2>;

use Gnome::Gdk4::Drop:api<2>;
use Gnome::Gdk4::T-enums:api<2>;
use Gnome::Gdk4::ContentProvider:api<2>;
use Gnome::Gdk4::N-ContentFormats:api<2>;
use Gnome::Gdk4::T-contentformats:api<2>;
use Gnome::Gdk4::T-enums:api<2>;
use Gnome::Gdk4::T-drag:api<2>;

use Gnome::N::GlibToRakuTypes:api<2>;
use Gnome::N::N-Object:api<2>;
use Gnome::N::X:api<2>;
#Gnome::N::debug(:on);

use Gnome::GObject::T-value:api<2>;

#-------------------------------------------------------------------------------
my Gnome::Glib::N-MainLoop $main-loop .= new-mainloop( N-Object, True);

#-------------------------------------------------------------------------------
class Helper {
  constant DATA_PATH =
    $*HOME ~ '/Languages/Raku/Projects/gnome-source-skim-tool/xt/Other/data/';
  has GnomeTools::Gtk::DND $!dnd;
  has Gnome::Gtk4::Picture $!bullseye;

  #-----------------------------------------------------------------------------
  submethod BUILD ( ) {

    $!bullseye .= new-for-filename(DATA_PATH ~ 'bullseye.jpg');
    $!bullseye.set-size-request( 100, 100);

    $!dnd .= new;
    $!dnd.set-droptarget( self, $!bullseye);

    with my Gnome::Gtk4::Grid $grid .= new-grid {
      .attach( $!bullseye, 0, 1, 3, 3);
    }

    with my Gnome::Gtk4::Window $window .= new-window {
      .set-title('Drop test');
      .set-child($grid);

      .register-signal( self, 'exit', 'close-request');
      .present;
    }
  }

  #-----------------------------------------------------------------------------
   method exit ( ) {
    $main-loop.quit;
  }

  #-----------------------------------------------------------------------------
  method drag-accept (
    Gnome::Gdk4::Drop() $drop, 
    Gnome::Gtk4::DropTarget() :_native-object($dt),
    --> gboolean
  ) {
    note "\n$?LINE accept";
    $dt.set-preload(False);
    $!dnd.check-accept( $drop, 'text');
  }

  #-----------------------------------------------------------------------------
  method drag-drop (
    N-Value() $n-value, Rat() $x, Rat() $y,
    Gnome::Gtk4::DropTarget() :_native-object($dt),
    --> gboolean
  ) {
    note "\n$?LINE drop, x, y = $x, $y";

    my ( Bool $internal, Str $value ) = $!dnd.get-dropped-value( $n-value, $dt);
    note "Internal drop: $internal\nDropped value: $value";

    True;
  }

  #-----------------------------------------------------------------------------
  method drag-enter (
    Rat() $x, Rat() $y --> GFlag
  ) {
    note "Enter at $x, $y";
    GDK_ACTION_COPY;# +| GDK_ACTION_MOVE +| GDK_ACTION_LINK
  }

  #-----------------------------------------------------------------------------
  method drag-leave ( ) {
    note "Left";
  }

  #-----------------------------------------------------------------------------
  method drag-motion (
    Rat() $x, Rat() $y --> GFlag
  ) {
    note "move to $x, $y";
    GDK_ACTION_COPY; # +| GDK_ACTION_MOVE +| GDK_ACTION_LINK
  }
}


my Helper $helper .= new;
#Gnome::N::debug(:on);

$main-loop.run;
say 'done it';
